<!-- ==================== TOAST NOTIFICATION ==================== -->
<div class="toast" id="toast"></div>

<!-- ==================== JAVASCRIPT ==================== -->
<script>
// ---- Product Data (INR Prices) ----
const products = [
  {id:1, name:"iPhone 15 Pro",       category:"electronics", emoji:"📱", brand:"Apple",   price:134900, original:149900, rating:4.8, reviews:2341,  badge:"Hot",         badgeType:"hot",  bg:"#fff5f5"},
  {id:2, name:"Samsung Galaxy S24",  category:"electronics", emoji:"📲", brand:"Samsung", price:74999,  original:89999,  rating:4.7, reviews:1820,  badge:"Sale",        badgeType:"sale", bg:"#f0f9ff"},
  {id:3, name:"boAt Airdopes 141",   category:"electronics", emoji:"🎧", brand:"Boat",    price:1299,   original:2990,   rating:4.3, reviews:45621, badge:"Best Seller",  badgeType:"hot",  bg:"#f0fff4"},
  {id:4, name:"Nike Air Force 1",    category:"fashion",     emoji:"👟", brand:"Nike",    price:8495,   original:9995,   rating:4.6, reviews:3201,  badge:"New",         badgeType:"new",  bg:"#fffbf0"},
  {id:5, name:"Levi's 511 Slim Fit", category:"fashion",     emoji:"👖", brand:"Levi's",  price:2799,   original:4499,   rating:4.4, reviews:8920,  badge:"Sale",        badgeType:"sale", bg:"#f0f4ff"},
  {id:6, name:"Prestige Cooker",     category:"home",        emoji:"🍳", brand:"Prestige",price:1850,   original:2500,   rating:4.7, reviews:12034, badge:"Trusted",     badgeType:"new",  bg:"#fff9f0"},
  {id:7, name:"Dyson V12 Vacuum",    category:"home",        emoji:"🌀", brand:"Dyson",   price:43900,  original:54900,  rating:4.5, reviews:1204,  badge:"Premium",     badgeType:"hot",  bg:"#faf0ff"},
  {id:8, name:"Lakme Foundation",    category:"beauty",      emoji:"💄", brand:"Lakme",   price:549,    original:799,    rating:4.2, reviews:34201, badge:"New",         badgeType:"new",  bg:"#fff0f7"},
  {id:9, name:"Yoga Mat Pro",        category:"sports",      emoji:"🧘", brand:"Boldfit", price:699,    original:1299,   rating:4.4, reviews:8912,  badge:"Sale",        badgeType:"sale", bg:"#f0fff9"},
  {id:10,name:"MacBook Air M3",      category:"electronics", emoji:"💻", brand:"Apple",   price:114900, original:129900, rating:4.9, reviews:908,   badge:"New",         badgeType:"new",  bg:"#f5f5ff"},
  {id:11,name:"Kanjeevaram Saree",   category:"fashion",     emoji:"🥻", brand:"FabIndia",price:3499,   original:5500,   rating:4.8, reviews:2201,  badge:"Indian",      badgeType:"new",  bg:"#fff5e6"},
  {id:12,name:"Cricket Bat MSD",     category:"sports",      emoji:"🏏", brand:"SG",      price:2799,   original:3999,   rating:4.6, reviews:4120,  badge:"Hot",         badgeType:"hot",  bg:"#f0fff4"},
];

let cart = [];
let filteredProducts = [...products];
let currentCategory = 'all';
let maxPrice = 100000;

// ---- Utility ----
function formatPrice(p){ return '₹' + p.toLocaleString('en-IN'); }
function discount(orig, curr){ return Math.round((orig - curr) / orig * 100); }

// ---- Render Products ----
function renderProducts(list){
  const grid = document.getElementById('product-grid');
  if(!list.length){
    grid.innerHTML = '<p style="color:var(--muted);grid-column:1/-1;text-align:center;padding:3rem;">No products found.</p>';
    return;
  }
  grid.innerHTML = list.map(p => `
    <div class="product-card">
      <div class="product-img" style="background:${p.bg}">${p.emoji}
        <span class="product-badge ${p.badgeType}">${p.badge}</span>
        <button class="wishlist-btn" onclick="toggleWish(this)" title="Wishlist">🤍</button>
      </div>
      <div class="product-info">
        <div class="product-category">${p.brand}</div>
        <div class="product-name">${p.name}</div>
        <div class="product-rating">
          <span class="stars">★</span> ${p.rating} <span>(${p.reviews.toLocaleString('en-IN')})</span>
        </div>
        <div class="product-price">
          <span class="price-current">${formatPrice(p.price)}</span>
          <span class="price-original">${formatPrice(p.original)}</span>
          <span class="price-discount">${discount(p.original, p.price)}% off</span>
        </div>
        <button class="add-to-cart" onclick="addToCart(${p.id})">+ Add to Cart</button>
      </div>
    </div>
  `).join('');
}

// ---- Filters ----
function filterCategory(cat, btn){
  currentCategory = cat;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}

function filterPrice(val){
  maxPrice = parseInt(val);
  document.getElementById('price-max').textContent = '₹' + parseInt(val).toLocaleString('en-IN');
  applyFilters();
}

function applyFilters(){
  filteredProducts = products.filter(p => {
    const catMatch = currentCategory === 'all' || p.category === currentCategory;
    const priceMatch = p.price <= maxPrice;
    return catMatch && priceMatch;
  });
  renderProducts(filteredProducts);
}

function sortProducts(val){
  let list = [...filteredProducts];
  if(val === 'price-asc') list.sort((a, b) => a.price - b.price);
  else if(val === 'price-desc') list.sort((a, b) => b.price - a.price);
  else if(val === 'rating') list.sort((a, b) => b.rating - a.rating);
  renderProducts(list);
}

// ---- Cart ----
function addToCart(id){
  const p = products.find(x => x.id === id);
  const existing = cart.find(x => x.id === id);
  if(existing) existing.qty++;
  else cart.push({...p, qty: 1});
  updateCartUI();
  showToast(`${p.emoji} ${p.name} added to cart!`);
}

function updateCartUI(){
  const count = cart.reduce((s, i) => s + i.qty, 0);
  document.getElementById('cart-count').textContent = count;
  const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
  document.getElementById('cart-total-price').textContent = formatPrice(total);

  const list = document.getElementById('cart-items-list');
  if(!cart.length){
    list.innerHTML = `<div class="cart-empty"><span class="icon">🛒</span><p>Your cart is empty</p><p style="font-size:0.82rem;color:var(--muted);margin-top:0.5rem;">Add items to get started</p></div>`;
    return;
  }
  list.innerHTML = cart.map((item, i) => `
    <div class="cart-item">
      <div class="cart-item-icon">${item.emoji}</div>
      <div class="cart-item-info">
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-price">${formatPrice(item.price)}</div>
      </div>
      <div class="cart-item-qty">
        <button class="qty-btn" onclick="changeQty(${i}, -1)">−</button>
        <span style="font-size:0.9rem;font-weight:600;min-width:20px;text-align:center">${item.qty}</span>
        <button class="qty-btn" onclick="changeQty(${i}, 1)">+</button>
      </div>
    </div>
  `).join('');
}

function changeQty(i, d){
  cart[i].qty += d;
  if(cart[i].qty <= 0) cart.splice(i, 1);
  updateCartUI();
}

function openCart(){ document.getElementById('cart-overlay').classList.add('open'); document.getElementById('cart-panel').classList.add('open'); }
function closeCart(){ document.getElementById('cart-overlay').classList.remove('open'); document.getElementById('cart-panel').classList.remove('open'); }
function checkout(){ closeCart(); showToast('🎉 Order placed! You will receive a confirmation SMS.'); }
function toggleWish(btn){ btn.textContent = btn.textContent === '🤍' ? '❤️' : '🤍'; }

// ---- Toast ----
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ---- Auth Modal ----
function openLogin(){ document.getElementById('login-modal').classList.add('open'); }
function closeLoginOutside(e){ if(e.target === document.getElementById('login-modal')) document.getElementById('login-modal').classList.remove('open'); }
function fakeLogin(){ document.getElementById('login-modal').classList.remove('open'); showToast('✅ Welcome to ShopBhārat!'); }
function switchAuthTab(t){
  document.getElementById('login-form').style.display = t === 'login' ? 'block' : 'none';
  document.getElementById('register-form').style.display = t === 'register' ? 'block' : 'none';
  document.getElementById('login-tab').classList.toggle('active', t === 'login');
  document.getElementById('register-tab').classList.toggle('active', t === 'register');
}
function selectRole(el, r){ document.querySelectorAll('.role-opt').forEach(o => o.classList.remove('active')); el.classList.add('active'); }

// ---- Page Navigation ----
function showPage(page){
  document.getElementById('hero-section').style.display = page === 'shop' ? '' : 'none';
  document.querySelector('.stats-bar').style.display = page === 'shop' ? '' : 'none';
  document.getElementById('shop-page').style.display = page === 'shop' ? '' : 'none';
  document.getElementById('orders-page').style.display = page === 'orders' ? '' : 'none';
  document.getElementById('admin-page').style.display = page === 'admin' ? '' : 'none';
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  event.target.classList.add('active');
  if(page === 'orders') renderOrders();
}

function scrollToProducts(){ document.getElementById('product-section').scrollIntoView({behavior:'smooth'}); }

// ---- Order Tracking ----
const ordersData = [
  {id:'SB-2024-001', product:'iPhone 15 Pro 📱',     amount:134900, status:'Delivered', steps:4},
  {id:'SB-2024-002', product:'boAt Airdopes 141 🎧', amount:1299,   status:'Shipped',   steps:3},
  {id:'SB-2024-003', product:'Nike Air Force 1 👟',  amount:8495,   status:'Processing',steps:2},
];

function renderOrders(){
  const el = document.getElementById('orders-list');
  const stepNames = ['Ordered', 'Packed', 'Shipped', 'Delivered'];
  el.innerHTML = ordersData.map(o => `
    <div class="order-card">
      <div class="order-top">
        <div>
          <div class="order-id">Order ${o.id}</div>
          <div style="font-size:0.85rem;color:var(--muted);margin-top:0.2rem;">${o.product}</div>
        </div>
        <div>
          <span class="order-status status-${o.status.toLowerCase()}">${o.status}</span>
          <div style="font-size:0.8rem;color:var(--muted);margin-top:0.3rem;text-align:right;">${formatPrice(o.amount)}</div>
        </div>
      </div>
      <div class="track-steps">
        ${stepNames.map((s, i) => `
          <div class="track-step ${i < o.steps ? 'done' : ''} ${i === o.steps - 1 ? 'current' : ''}">
            <div class="step-dot">${i < o.steps ? '✓' : i + 1}</div>
            <div class="step-label">${s}</div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');
}

function trackOrder(){
  const id = document.getElementById('order-input').value.trim();
  if(!id){ showToast('⚠️ Please enter an Order ID'); return; }
  const found = ordersData.find(o => o.id.toLowerCase() === id.toLowerCase());
  if(found) showToast(`✅ ${found.id}: ${found.status}`);
  else showToast('❌ Order not found. Try: SB-2024-001');
}

// ---- Init ----
renderProducts(products);
updateCartUI();
</script>
</body>
</html>
